# Qué servicio de autenticación usa la app.
# "mock" = cuentas de prueba guardadas en el navegador (no necesita servidor). Es lo que
#          usan el modo desarrollo y los tests.
# "supabase" = cuentas reales y progreso en la nube. La versión publicada lo toma de
#          .env.production (con la URL y la clave publicable del proyecto).
VITE_AUTH_PROVIDER=mock
# VITE_SUPABASE_URL=https://<id-del-proyecto>.supabase.co
# VITE_SUPABASE_KEY=sb_publishable_…

# Ruta base donde se publica la app. En GitHub Pages es /nombre-del-repo/
# (el workflow de deploy la completa solo).
VITE_BASE=/
