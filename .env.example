# Qué servicio de autenticación usa la app.
# "mock" = cuentas de prueba guardadas en el navegador (no necesita servidor).
# Cuando conecten un backend real (Supabase, Firebase, API propia), agreguen su
# implementación en src/services/auth/ y cámbienlo aquí.
VITE_AUTH_PROVIDER=mock

# Ruta base donde se publica la app. En GitHub Pages es /nombre-del-repo/
# (el workflow de deploy la completa solo).
VITE_BASE=/
